{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@viapip/eslint-config",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "yarn@4.8.0",
  "description": "",
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/viapip/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viapip/eslint-config.git"
  },
  "bugs": "",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkgroll --minify",
    "typecheck": "tsc --noEmit",
    "dev": "esno src/index.ts",
    "start": "node --experimental-modules --experimental-import-meta-resolve dist/index.js",
    "release": "yarn publish",
    "lint": "eslint --flag unstable_ts_config .",
    "clean": "yarn exec rm -rf dist"
  },
  "dependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "defu": "^6.1.4",
    "@types/esm": "^3.2.2",
    "esm": "^3.2.25",
    "esno": "^4.8.0",
    "jiti": "^2.5.1"
  },
  "devDependencies": {
    "@antfu/utils": "^9.2.0",
    "@types/node": "^24.3.1",
    "@yarnpkg/doctor": "^4.0.4",
    "consola": "^3.4.2",
    "eslint": "^9.35.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lint-staged": "^15.5.2",
    "pkgroll": "^2.15.4",
    "simple-git-hooks": "^2.13.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,vue}": "eslint --flag unstable_ts_config --fix"
  },
  "dependenciesMeta": {
    "@rollup/plugin-typescript@11.1.1": {
      "unplugged": true
    },
    "rollup-plugin-esbuild@5.0.0": {
      "unplugged": true
    }
  }
}
